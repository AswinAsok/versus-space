# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# VITE_API_BASE_URL=http://127.0.0.1:8787

# DodoPayments Configuration
# Get your product ID from DodoPayments dashboard after creating a Pro subscription product
VITE_DODO_PRO_PRODUCT_ID=your_dodo_product_id

# Webhook secrets (set through Cloudflare secret management, never VITE_*)
# DODO_WEBHOOK_KEY - your DodoPayments webhook signing key
