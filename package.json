{
  "name": "versus-space",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "vite build",
    "cf:deploy": "npm run build:cloudflare && wrangler deploy",
    "cf:deploy:staging": "npm run build:cloudflare && wrangler deploy --env staging",
    "cf:dev": "npm run build:cloudflare && wrangler dev --env-file worker/.env.example",
    "cf:typegen": "wrangler types worker-configuration.d.ts --env-file worker/.env.example",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local --env-file worker/.env.example",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote --env-file worker/.env.example",
    "auth:migration:self-check": "node scripts/auth-migration-self-check.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@tanstack/react-query": "^5.90.14",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "3.0.3",
    "better-auth": "1.6.23",
    "lucide-react": "^0.344.0",
    "motion": "^12.23.26",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-d3-speedometer": "^3.1.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wrangler": "^4.110.0"
  }
}
